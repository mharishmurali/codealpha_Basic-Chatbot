def chatbot_response(user_input):

    user_input = user_input.lower().strip()

    if user_input == "hello":
        return "Hi! Welcome to our chatbot."

    elif user_input == "hi":
        return "Hello! How can I help you?"

    elif user_input == "how are you":
        return "I'm fine, thanks! How are you?"

    elif user_input == "i am fine":
        return "That's great! How can I help you today?"

    elif user_input == "what is your name":
        return "I'm a simple Python chatbot."

    elif user_input == "what can you do":
        return "I can chat with you and answer simple predefined messages."

    elif user_input == "thank you":
        return "You're welcome!"

    elif user_input == "bye":
        return "Goodbye! Have a nice day."

    else:
        return "Sorry, I don't understand that. Please try something else."


def start_chatbot():

    print("-----------------------------------")
    print("       WELCOME TO CHATBOT")
    print("-----------------------------------")
    print("Chatbot: Hello! How can I help you?")
    print("Type 'bye' to exit the chatbot.")
    print("-----------------------------------")

    while True:

        user_input = input("You: ")

        # Get chatbot response
        response = chatbot_response(user_input)

        print("Chatbot:", response)

        if user_input.lower().strip() == "bye":
            break

    print("-----------------------------------")
    print("Chatbot session ended.")
    print("Thank you for chatting!")
    print("-----------------------------------")


if _name_ == "_main_":
    start_chatbot()
